# Site block for the edge Caddy that already serves api.vepathos.com on the same host.
# On api-prod that Caddy is already on `vepathos-net` (use deploy/docker-compose.apiprod.yml
# so this container joins the same network). DNS: an A record for mcp.vepathos.com must
# resolve to this host before Caddy reloads, so Let's Encrypt can issue the certificate.
#
# Host file on api-prod:
#   ~/vepathos-deploy/vepathos-router-client/deploy/hetzner/vm-api/Caddyfile
# Confirm with: docker inspect vepathos-caddy --format '{{range .Mounts}}{{println .Source}}{{end}}'

mcp.vepathos.com {
	# Operational endpoints stay private: health checks run inside Docker, metrics are scraped internally.
	@private path /metrics
	respond @private 404

	request_body {
		max_size 8MB
	}

	reverse_proxy vepathos-mcp:8080 {
		# Stream SSE responses (progress notifications) without buffering.
		flush_interval -1
		transport http {
			dial_timeout 5s
			# Tools answer within ~55 s (bounded waits); optimizations continue asynchronously in Core.
			response_header_timeout 75s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	encode zstd gzip
}
