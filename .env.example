# vepathos-mcp configuration. Copy to `.env` for local development. Never commit real values.

# development | test | production  (production enforces https, OAuth-capable settings and secrets)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- HTTP surface ---------------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Public URL of this server; the MCP resource URI is MCP_PUBLIC_URL + MCP_PATH
MCP_PUBLIC_URL=http://localhost:8080
MCP_PATH=/mcp
# DNS-rebinding protection (Host / Origin allow-lists)
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
MCP_MAX_REQUEST_BODY_BYTES=8388608
# Optional: require this bearer on /metrics (otherwise only private networks can scrape it)
METRICS_BEARER_TOKEN=

# --- Vepathos Core (MCP channel) ----------------------------------------------------------
VEPATHOS_API_BASE_URL=http://localhost:3000
# Shared secret identifying this service to the Core MCP channel. Grants no account access alone.
VEPATHOS_MCP_SERVICE_KEY=change-me
VEPATHOS_API_TIMEOUT_SECONDS=20
VEPATHOS_API_SUBMIT_TIMEOUT_SECONDS=45

# --- Authentication ---------------------------------------------------------------------------
# Comma-separated: oauth (production), api_key (developers/headless), service (local dev only)
AUTH_MODES=service
OAUTH_ISSUER=https://api.vepathos.com
OAUTH_JWKS_URL=https://api.vepathos.com/api/jwks
OAUTH_SCOPE=optimize
# Local Core AS (vepathos-api-doc-mcp on :3001). Pair with AUTH_MODES=oauth,api_key
# and Core MCP_RESOURCE_URI=http://localhost:8080 so JWT aud matches this resource.
# OAUTH_ISSUER=http://localhost:3001
# OAUTH_JWKS_URL=http://localhost:3001/api/jwks
# service mode / stdio transport: the Vepathos credential used for every call ("client_id:client_secret")
VEPATHOS_SERVICE_CREDENTIAL=
# service mode: inbound bearer token MCP clients must send
MCP_DEV_BEARER_TOKEN=
# Salt for hashed account keys in logs and rate limiting (set a random value in production)
ACCOUNT_HASH_SALT=

# Require an explicit confirmed=true before optimize_routes spends plan stops.
MCP_CONFIRM_BEFORE_OPTIMIZE=false

# --- Behaviour budgets --------------------------------------------------------------------------
MCP_OPTIMIZE_INLINE_WAIT_SECONDS=8
MCP_RESULT_LONGPOLL_SECONDS=20
MCP_POLL_INTERVAL_SECONDS=2
MCP_RATE_LIMIT_OPTIMIZE_PER_MINUTE=10
MCP_RATE_LIMIT_CALLS_PER_MINUTE=120
MCP_RATE_LIMIT_CATALOG_WRITES_PER_MINUTE=20
# Expose create_optimization_map when the Core map-share feature is enabled.
MCP_MAP_SHARES_ENABLED=false
# Publish the import tools (import_deliveries … list_datasets). Needs a Core with /imports and
# /datasets (list_plans and optimize_routes are published regardless). Keep false in production
# until the ChatGPT staging smoke passes.
MCP_IMPORT_TOOLS_ENABLED=false
# Publish manage_catalog (the account's saved vehicles and depots). Needs a Core with
# /catalog/vehicles and /catalog/depots. Keep false in production until the staging smoke passes.
MCP_CATALOG_WRITE_TOOLS_ENABLED=false

# Trusted proxy addresses for X-Forwarded-* (the reverse proxy in front of the container)
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Local testing only (never in production) ---------------------------------------------------
# MCP developer credentials for the integration tests and the smoke scripts: created in the dashboard
# with purpose MCP (the client_id starts with vpt_mcp_ and the scope is mcp:optimize; a routes API key
# is refused by the channel). One account on a paid plan and one on Free, so the plan limits are
# exercised too. docs/testing.md and docs/agent-test-plan.md read them from here.
VEPATHOS_GROWTH_CREDENTIAL=
VEPATHOS_FREE_CREDENTIAL=
